    "hint_permission_alerts_sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me before due dates"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियत तिथियों से पहले मुझे सूचित करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ধারিত তারিখের আগে আমাকে অবহিত করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడువు తేదీలకు ముందే నాకు తెలియజేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "देय तारखांच्या आधी मला सूचित करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலுவைத் தேதிகளுக்கு முன் எனக்குத் தெரிவிக்கவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિયત તારીખો પહેલાં મને સૂચિત કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಗದಿತ ದಿನಾಂಕಗಳ ಮೊದಲು ನನಗೆ ಸೂಚಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിശ്ചിത തീയതികൾക്ക് മുമ്പ് എന്നെ അറിയിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਯਤ ਮਿਤੀਆਂ ਤੋਂ ਪਹਿਲਾਂ ਮੈਨੂੰ ਸੂਚਿਤ ਕਰੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez-moi avant les dates d'échéance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificarme antes de las fechas de vencimiento"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلمني قبل مواعيد الاستحقاق"
          }
        }
      }
    },
    "hint_permission_autofill_short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-fill from bank alerts"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंक अलर्ट से स्वतः भरें"
