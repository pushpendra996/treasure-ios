    "hint_invalid_verification_code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification code entered was invalid"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज किया गया सत्यापन कोड अमान्य था"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রবেশ করা যাচাইকরণ কোডটি অবৈধ ছিল৷"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమోదు చేసిన ధృవీకరణ కోడ్ చెల్లదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रविष्ट केलेला सत्यापन कोड अवैध होता"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளிட்ட சரிபார்ப்புக் குறியீடு தவறானது"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દાખલ કરેલ ચકાસણી કોડ અમાન્ય હતો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮೂದಿಸಿದ ಪರಿಶೀಲನಾ ಕೋಡ್ ಅಮಾನ್ಯವಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നൽകിയ പരിശോധനാ കോഡ് അസാധുവാണ്"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਾਖਲ ਕੀਤਾ ਪੁਸ਼ਟੀਕਰਨ ਕੋਡ ਅਵੈਧ ਸੀ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de vérification saisi n'était pas valide"
          }
        },
        "es": {
