    "hint_report_year_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar year %1$d · Based on your saved transactions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर वर्ष %1$d · आपके सहेजे गए लेनदेन के आधार पर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার বছর %1$d · আপনার সংরক্ষিত লেনদেনের উপর ভিত্তি করে"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలెండర్ సంవత్సరం %1$d · మీరు సేవ్ చేసిన లావాదేవీల ఆధారంగా"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलेंडर वर्ष %1$d · तुमच्या सेव्ह केलेल्या व्यवहारांवर आधारित"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
