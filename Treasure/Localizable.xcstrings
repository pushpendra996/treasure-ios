    "hint_needs_internet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs internet. Try again when you're online."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए इंटरनेट की जरूरत है. जब आप ऑनलाइन हों तो पुनः प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর জন্য ইন্টারনেট প্রয়োজন। আপনি যখন অনলাইনে থাকবেন তখন আবার চেষ্টা করুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీనికి ఇంటర్నెట్ అవసరం. మీరు ఆన్‌లైన్‌లో ఉన్నప్పుడు మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यासाठी इंटरनेटची गरज आहे. तुम्ही ऑनलाइन असताना पुन्हा प्रयत्न करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதற்கு இணையம் தேவை. நீங்கள் ஆன்லைனில் இருக்கும்போது மீண்டும் முயற்சிக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ માટે ઇન્ટરનેટની જરૂર છે. જ્યારે તમે ઑનલાઇન હોવ ત્યારે ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದಕ್ಕೆ ಇಂಟರ್ನೆಟ್ ಅಗತ್ಯವಿದೆ. ನೀವು ಆನ್‌ಲೈನ್‌ನಲ್ಲಿರುವಾಗ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന് ഇൻ്റർനെറ്റ് ആവശ്യമാണ്. നിങ്ങൾ ഓൺലൈനിലായിരിക്കുമ്പോൾ വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਈ ਇੰਟਰਨੈੱਟ ਦੀ ਲੋੜ ਹੈ। ਜਦੋਂ ਤੁਸੀਂ ਔਨਲਾਈਨ ਹੋਵੋ ਤਾਂ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nécessite Internet. Réessayez lorsque vous êtes en ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto necesita internet. Inténtalo de nuevo cuando estés en línea."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وهذا يحتاج إلى الإنترنت. حاول مرة أخرى عندما تكون متصلاً بالإنترنت."
          }
        }
      }
    },
