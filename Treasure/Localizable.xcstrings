    "hint_no_committees": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not added to any committee yet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको अभी तक किसी भी समिति में नहीं जोड़ा गया है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনো কোনো কমিটিতে যোগ করেননি।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా ఏ కమిటీకి జోడించబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला अद्याप कोणत्याही समितीमध्ये सामील करण्यात आलेले नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இதுவரை எந்தக் குழுவிலும் சேர்க்கப்படவில்லை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હજુ સુધી કોઈપણ સમિતિમાં ઉમેરાયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮನ್ನು ಇನ್ನೂ ಯಾವುದೇ ಸಮಿತಿಗೆ ಸೇರಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളെ ഇതുവരെ ഒരു കമ്മിറ്റിയിലും ചേർത്തിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਨੂੰ ਅਜੇ ਤੱਕ ਕਿਸੇ ਵੀ ਕਮੇਟੀ ਵਿੱਚ ਸ਼ਾਮਲ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes encore ajouté à aucun comité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no estás agregado a ningún comité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم إضافتك إلى أي لجنة بعد."
          }
        }
      }
    },
    "hint_no_committees_created": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have not created any committee yet. Tap + to create one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी तक कोई समिति नहीं बनाई है. एक बनाने के लिए + टैप करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনারা এখনো কোনো কমিটি করেননি। একটি তৈরি করতে + আলতো চাপুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా ఏ కమిటీని సృష్టించలేదు. ఒకదాన్ని సృష్టించడానికి + నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपण अद्याप कोणतीही समिती तयार केलेली नाही. एक तयार करण्यासाठी + वर टॅप करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இதுவரை எந்தக் குழுவையும் உருவாக்கவில்லை. ஒன்றை உருவாக்க + தட்டவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હજુ સુધી કોઈ કમિટી બનાવી નથી. એક બનાવવા માટે + પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇನ್ನೂ ಯಾವುದೇ ಸಮಿತಿಯನ್ನು ರಚಿಸಿಲ್ಲ. ಒಂದನ್ನು ರಚಿಸಲು + ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതുവരെ ഒരു കമ്മിറ്റിയും സൃഷ്ടിച്ചിട്ടില്ല. ഒരെണ്ണം സൃഷ്‌ടിക്കാൻ + ടാപ്പുചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਅਜੇ ਤੱਕ ਕੋਈ ਕਮੇਟੀ ਨਹੀਂ ਬਣਾਈ ਹੈ। ਇੱਕ ਬਣਾਉਣ ਲਈ + 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez encore créé aucun comité. Appuyez sur + pour en créer un."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has creado ningún comité. Toca + para crear uno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تقم بإنشاء أي لجنة بعد. اضغط على + لإنشاء واحدة."
          }
        }
      }
    },
    "hint_no_committees_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Committees"
          }
        }
      }
    },
    "hint_no_country_found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no country found. Please try again later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई देश नहीं मिला. कृपया बाद में पुन: प्रयास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন দেশ খুঁজে পাওয়া যায় না। পরে আবার চেষ্টা করুন."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దేశం కనుగొనబడలేదు. దయచేసి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकही देश सापडला नाही. कृपया नंतर पुन्हा प्रयत्न करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த நாடும் கிடைக்கவில்லை. பிறகு முயற்சிக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ત્યાં કોઈ દેશ મળ્યો નથી. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ದೇಶ ಕಂಡುಬಂದಿಲ್ಲ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു രാജ്യവും കണ്ടെത്തിയില്ല. ദയവായി പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਦੇਸ਼ ਨਹੀਂ ਮਿਲਿਆ। ਕਿਰਪਾ ਕਰਕੇ ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pays n'a été trouvé. Veuillez réessayer plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún país. Inténtelo de nuevo más tarde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على أي دولة. يرجى المحاولة مرة أخرى في وقت لاحق."
          }
        }
      }
    },
    "hint_no_country_search": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No country matches your search. Try a different query."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी देश आपकी खोज से मेल नहीं खाता. कोई भिन्न क्वेरी आज़माएँ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো দেশ আপনার অনুসন্ধানের সাথে মেলে না। একটি ভিন্ন প্রশ্ন চেষ্টা করুন."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ శోధనకు ఏ దేశం సరిపోలలేదు. వేరొక ప్రశ్నను ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणताही देश तुमच्या शोधाशी जुळत नाही. भिन्न क्वेरी वापरून पहा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தேடலுக்கு எந்த நாடும் பொருந்தவில்லை. வேறு வினவலை முயற்சிக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ દેશ તમારી શોધ સાથે મેળ ખાતો નથી. એક અલગ ક્વેરી અજમાવી જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ದೇಶವು ನಿಮ್ಮ ಹುಡುಕಾಟಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ. ಬೇರೆ ಪ್ರಶ್ನೆಯನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ തിരയലുമായി ഒരു രാജ്യവും പൊരുത്തപ്പെടുന്നില്ല. മറ്റൊരു ചോദ്യം പരീക്ഷിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਵੀ ਦੇਸ਼ ਤੁਹਾਡੀ ਖੋਜ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ। ਇੱਕ ਵੱਖਰੀ ਪੁੱਛਗਿੱਛ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pays ne correspond à votre recherche. Essayez une autre requête."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún país coincide con su búsqueda. Pruebe una consulta diferente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد بلد يطابق بحثك. حاول استعلام مختلف."
          }
        }
      }
    },
    "hint_no_expense_groups": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not in any expense group yet. Tap + to create one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी तक किसी व्यय समूह में नहीं हैं. एक बनाने के लिए + टैप करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনও কোনো খরচ গ্রুপে নেই. একটি তৈরি করতে + আলতো চাপুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా ఏ ఖర్చు సమూహంలో లేరు. ఒకదాన్ని సృష్టించడానికి + నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही अद्याप कोणत्याही खर्चाच्या गटात नाही. एक तयार करण्यासाठी + वर टॅप करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இதுவரை எந்த செலவுக் குழுவிலும் இல்லை. ஒன்றை உருவாக்க + தட்டவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હજુ સુધી કોઈપણ ખર્ચ જૂથમાં નથી. એક બનાવવા માટે + પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇನ್ನೂ ಯಾವುದೇ ಖರ್ಚು ಗುಂಪಿನಲ್ಲಿಲ್ಲ. ಒಂದನ್ನು ರಚಿಸಲು + ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതുവരെ ഒരു ചെലവ് ഗ്രൂപ്പിലും ഇല്ല. ഒരെണ്ണം സൃഷ്‌ടിക്കാൻ + ടാപ്പുചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਅਜੇ ਤੱਕ ਕਿਸੇ ਵੀ ਖਰਚ ਸਮੂਹ ਵਿੱਚ ਨਹੀਂ ਹੋ। ਇੱਕ ਬਣਾਉਣ ਲਈ + 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'êtes encore dans aucun groupe de dépenses. Appuyez sur + pour en créer un."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no estás en ningún grupo de gastos. Toca + para crear uno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت لست في أي مجموعة حساب حتى الآن. اضغط على + لإنشاء واحدة."
          }
        }
      }
    },
    "hint_no_internet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Changes will sync when you're back."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं. आपके वापस आने पर परिवर्तन समन्वयित हो जाएंगे."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অফলাইনে আছেন। আপনি ফিরে এলে পরিবর্তনগুলি সিঙ্ক হবে৷"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆఫ్‌లైన్‌లో ఉన్నారు. మీరు తిరిగి వచ్చినప్పుడు మార్పులు సమకాలీకరించబడతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ऑफलाइन आहात. तुम्ही परत आल्यावर बदल सिंक केले जातील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆஃப்லைனில் உள்ளீர்கள். நீங்கள் திரும்பி வரும்போது மாற்றங்கள் ஒத்திசைக்கப்படும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઑફલાઇન છો. જ્યારે તમે પાછા આવશો ત્યારે ફેરફારો સમન્વયિત થશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿರುವಿರಿ. ನೀವು ಹಿಂತಿರುಗಿದಾಗ ಬದಲಾವಣೆಗಳು ಸಿಂಕ್ ಆಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഓഫ്‌ലൈനാണ്. നിങ്ങൾ തിരികെ വരുമ്പോൾ മാറ്റങ്ങൾ സമന്വയിപ്പിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਔਫਲਾਈਨ ਹੋ। ਤੁਹਾਡੇ ਵਾਪਸ ਆਉਣ 'ਤੇ ਤਬਦੀਲੀਆਂ ਦਾ ਸਮਕਾਲੀਕਰਨ ਕੀਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les modifications seront synchronisées à votre retour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás desconectado. Los cambios se sincronizarán cuando regreses."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت. ستتم مزامنة التغييرات عند عودتك."
          }
        }
      }
    },
    "hint_no_members_yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No members yet. Add people who should see this committee in the app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई सदस्य नहीं. उन लोगों को जोड़ें जिन्हें यह समिति ऐप में दिखनी चाहिए."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো সদস্য নেই। অ্যাপটিতে এমন ব্যক্তিদের যোগ করুন যাদের এই কমিটি দেখতে হবে।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా సభ్యులు లేరు. యాప్‌లో ఈ కమిటీని చూడాల్సిన వ్యక్తులను జోడించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्याप सदस्य नाहीत. ॲपमध्ये ज्या लोकांना ही समिती पाहावी लागेल त्यांना जोडा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் உறுப்பினர்கள் இல்லை. இந்தக் குழுவைப் பார்க்க வேண்டியவர்களை ஆப்ஸில் சேர்க்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ સુધી કોઈ સભ્યો નથી. એપમાં આ સમિતિને જોવી જોઈએ તેવા લોકોને ઉમેરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಸದಸ್ಯರಿಲ್ಲ. ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ಈ ಸಮಿತಿಯನ್ನು ನೋಡಬೇಕಾದ ಜನರನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ അംഗങ്ങളില്ല. ഈ കമ്മിറ്റി കാണേണ്ട ആളുകളെ ആപ്പിൽ ചേർക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਜੇ ਤੱਕ ਕੋਈ ਮੈਂਬਰ ਨਹੀਂ ਹਨ। ਉਹਨਾਂ ਲੋਕਾਂ ਨੂੰ ਸ਼ਾਮਲ ਕਰੋ ਜਿਨ੍ਹਾਂ ਨੂੰ ਐਪ ਵਿੱਚ ਇਸ ਕਮੇਟੀ ਨੂੰ ਦੇਖਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun membre pour l'instant. Ajoutez des personnes qui devraient voir ce comité dans l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay miembros. Agregue personas que deberían ver este comité en la aplicación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد أعضاء حتى الآن. أضف الأشخاص الذين يجب عليهم رؤية هذه اللجنة في التطبيق."
          }
        }
      }
    },
    "hint_no_shared_expenses": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expenses yet. Tap Add expense to record one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई खर्च नहीं. किसी को रिकॉर्ड करने के लिए खर्च जोड़ें पर टैप करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো খরচ নেই। একটি রেকর্ড করতে খরচ যোগ করুন আলতো চাপুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఖర్చులు లేవు. ఒకదాన్ని రికార్డ్ చేయడానికి ఖర్చును జోడించు నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून खर्च नाही. एक रेकॉर्ड करण्यासाठी खर्च जोडा टॅप करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் செலவுகள் இல்லை. ஒன்றை பதிவு செய்ய செலவைச் சேர் என்பதைத் தட்டவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ સુધી કોઈ ખર્ચ નથી. એક રેકોર્ડ કરવા માટે ખર્ચ ઉમેરો પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಯಾವುದೇ ವೆಚ್ಚವಿಲ್ಲ. ಒಂದನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಲು ಖರ್ಚು ಸೇರಿಸಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ചെലവുകളൊന്നുമില്ല. ഒന്ന് റെക്കോർഡ് ചെയ്യാൻ ചെലവ് ചേർക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਜੇ ਕੋਈ ਖਰਚਾ ਨਹੀਂ। ਇੱਕ ਰਿਕਾਰਡ ਕਰਨ ਲਈ ਖਰਚ ਸ਼ਾਮਲ ਕਰੋ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dépense pour l'instant. Appuyez sur Ajouter une dépense pour en enregistrer une."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay gastos. Toque Agregar gasto para registrar uno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد نفقات حتى الآن. انقر فوق إضافة حساب لتسجيل واحدة."
          }
        }
      }
    },
