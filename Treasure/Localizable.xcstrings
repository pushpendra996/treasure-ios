            "value": "அங்கீகரிக்கப்பட்டது: %1$.2f · நிலுவையில் உள்ளது: %2$.2f · நிராகரிக்கப்பட்ட உருப்படிகள்: %3$d"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મંજૂર: %1$.2f · બાકી: %2$.2f · નકારેલ આઇટમ્સ: %3$d"
          }
        },
        "kn": {
          "stringUnit": {
