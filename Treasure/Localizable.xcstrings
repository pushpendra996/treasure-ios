        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే ఈ వర్గాన్ని కలిగి ఉన్నారు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्याकडे ही श्रेणी आधीपासून आहे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களிடம் ஏற்கனவே இந்த வகை உள்ளது"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પાસે પહેલેથી જ આ શ્રેણી છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈಗಾಗಲೇ ಈ ವರ್ಗವನ್ನು ಹೊಂದಿರುವಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് ഇതിനകം ഈ വിഭാഗമുണ്ട്"
          }
        },
