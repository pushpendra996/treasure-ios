          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുറത്തുകടക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਗਆਉਟ"
          }
        },
        "fr": {
          "stringUnit": {
