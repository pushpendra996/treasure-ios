    "notification_sharing_expense_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to open the group expense list."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह व्यय सूची खोलने के लिए टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রুপ খরচ তালিকা খুলতে আলতো চাপুন."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమూహ ఖర్చుల జాబితాను తెరవడానికి నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गट खर्च सूची उघडण्यासाठी टॅप करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழு செலவுப் பட்டியலைத் திறக்க தட்டவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જૂથ ખર્ચની સૂચિ ખોલવા માટે ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುಂಪು ವೆಚ್ಚದ ಪಟ್ಟಿಯನ್ನು ತೆರೆಯಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗ്രൂപ്പ് ചെലവ് ലിസ്റ്റ് തുറക്കാൻ ടാപ്പ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੂਹ ਖਰਚਿਆਂ ਦੀ ਸੂਚੀ ਨੂੰ ਖੋਲ੍ਹਣ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour ouvrir la liste des dépenses du groupe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para abrir la lista de gastos del grupo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لفتح قائمة نفقات المجموعة."
          }
        }
      }
    },
    "notification_sharing_expense_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New expense in your group"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके समूह में नया खर्च"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার গ্রুপে নতুন খরচ"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సమూహంలో కొత్త ఖర్చు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या गटात नवीन खर्च"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் குழுவில் புதிய செலவு"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા જૂથમાં નવો ખર્ચ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಗುಂಪಿನಲ್ಲಿ ಹೊಸ ಖರ್ಚು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഗ്രൂപ്പിലെ പുതിയ ചെലവ്"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸਮੂਹ ਵਿੱਚ ਨਵਾਂ ਖਰਚਾ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle dépense dans votre groupe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo gasto en tu grupo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب جديد في مجموعتك"
          }
        }
      }
    }
  },
  "version": "1.1"
}
