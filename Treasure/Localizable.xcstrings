    "hint_update_ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update ready — restart to install"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट तैयार - इंस्टॉल करने के लिए पुनः आरंभ करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপডেট প্রস্তুত — ইনস্টল করতে পুনরায় চালু করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నవీకరణ సిద్ధంగా ఉంది - ఇన్‌స్టాల్ చేయడానికి పునఃప్రారంభించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट तयार आहे — इंस्टॉल करण्यासाठी रीस्टार्ट करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதுப்பிப்பு தயார் — நிறுவ மறுதொடக்கம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અપડેટ તૈયાર છે - ઇન્સ્ટોલ કરવા માટે પુનઃપ્રારંભ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್‌ಡೇಟ್ ಸಿದ್ಧವಾಗಿದೆ - ಸ್ಥಾಪಿಸಲು ಮರುಪ್ರಾರಂಭಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്‌ഡേറ്റ് തയ്യാറാണ് - ഇൻസ്റ്റാൾ ചെയ്യാൻ പുനരാരംഭിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਪਡੇਟ ਤਿਆਰ — ਇੰਸਟਾਲ ਕਰਨ ਲਈ ਮੁੜ-ਚਾਲੂ ਕਰੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour prête – redémarrez pour installer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización lista: reinicie para instalar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديث جاهز — أعد التشغيل للتثبيت"
          }
        }
      }
    },
