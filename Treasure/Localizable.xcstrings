    "hint_consent_autofill_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft transactions from UPI and bank payment alerts on this phone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर UPI से ड्राफ्ट लेनदेन और बैंक भुगतान अलर्ट।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে UPI এবং ব্যাঙ্ক পেমেন্ট সতর্কতা থেকে ড্রাফ্ট লেনদেন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోన్‌లో UPI మరియు బ్యాంక్ చెల్లింపు హెచ్చరికల నుండి డ్రాఫ్ట్ లావాదేవీలు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोनवर UPI आणि बँक पेमेंट अलर्ट वरून ड्राफ्ट व्यवहार."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மொபைலில் UPI மற்றும் பேங்க் பேமெண்ட் விழிப்பூட்டல்களில் இருந்து வரைவு பரிவர்த்தனைகள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોન પર UPI અને બેંક ચુકવણી ચેતવણીઓમાંથી ડ્રાફ્ટ વ્યવહારો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋನ್‌ನಲ್ಲಿ UPI ಮತ್ತು ಬ್ಯಾಂಕ್ ಪಾವತಿ ಎಚ್ಚರಿಕೆಗಳಿಂದ ಡ್ರಾಫ್ಟ್ ವಹಿವಾಟುಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോണിലെ UPI-ൽ നിന്നുള്ള ഇടപാടുകളുടെ ഡ്രാഫ്റ്റ്, ബാങ്ക് പേയ്‌മെൻ്റ് അലേർട്ടുകൾ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫੋਨ 'ਤੇ UPI ਅਤੇ ਬੈਂਕ ਭੁਗਤਾਨ ਅਲਰਟ ਤੋਂ ਡਰਾਫਟ ਟ੍ਰਾਂਜੈਕਸ਼ਨ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigez des transactions à partir des alertes UPI et de paiement bancaire sur ce téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borradores de transacciones de UPI y alertas de pagos bancarios en este teléfono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بصياغة المعاملات من UPI وتنبيهات الدفع البنكي على هذا الهاتف."
          }
        }
      }
    },
    "hint_consent_autofill_point1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads GPay, PhonePe & bank alerts"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe और बैंक अलर्ट पढ़ता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe এবং ব্যাঙ্ক সতর্কতা পড়ে"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe & బ్యాంక్ హెచ్చరికలను చదువుతుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe आणि बँक सूचना वाचते"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe & வங்கி விழிப்பூட்டல்களைப் படிக்கிறது"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe અને બેંક ચેતવણીઓ વાંચે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe ಮತ್ತು ಬ್ಯಾಂಕ್ ಎಚ್ಚರಿಕೆಗಳನ್ನು ಓದುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe, ബാങ്ക് അലേർട്ടുകൾ എന്നിവ വായിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GPay, PhonePe ਅਤੇ ਬੈਂਕ ਅਲਰਟ ਪੜ੍ਹਦਾ ਹੈ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les alertes GPay, PhonePe et bancaires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee GPay, PhonePe y alertas bancarias"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ تنبيهات GPay وPhonePe والبنك"
          }
        }
      }
    },
    "hint_consent_autofill_point2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You approve, edit, or reject each draft"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप प्रत्येक ड्राफ्ट को स्वीकृत, संपादित या अस्वीकार करते हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি প্রতিটি খসড়া অনুমোদন, সম্পাদনা বা প্রত্যাখ্যান করেন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ప్రతి డ్రాఫ్ట్‌ను ఆమోదించండి, సవరించండి లేదా తిరస్కరించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही प्रत्येक मसुदा मंजूर, संपादित किंवा नाकारता"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வரைவையும் நீங்கள் அங்கீகரிக்கிறீர்கள், திருத்துகிறீர்கள் அல்லது நிராகரிக்கிறீர்கள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે દરેક ડ્રાફ્ટને મંજૂર, સંપાદિત અથવા નકારી કાઢો છો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಪ್ರತಿ ಡ್ರಾಫ್ಟ್ ಅನ್ನು ಅನುಮೋದಿಸುತ್ತೀರಿ, ಸಂಪಾದಿಸುತ್ತೀರಿ ಅಥವಾ ತಿರಸ್ಕರಿಸುತ್ತೀರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഓരോ ഡ്രാഫ്റ്റും അംഗീകരിക്കുകയോ എഡിറ്റ് ചെയ്യുകയോ നിരസിക്കുകയോ ചെയ്യുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਹਰੇਕ ਡਰਾਫਟ ਨੂੰ ਮਨਜ਼ੂਰ, ਸੰਪਾਦਿਤ ਜਾਂ ਅਸਵੀਕਾਰ ਕਰਦੇ ਹੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous approuvez, modifiez ou rejetez chaque brouillon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted aprueba, edita o rechaza cada borrador"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت توافق على كل مسودة أو تعدلها أو ترفضها"
          }
        }
      }
    },
    "hint_consent_autofill_point3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is sent to analytics"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एनालिटिक्स को कुछ भी नहीं भेजा जाता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্লেষণে কিছুই পাঠানো হয় না"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విశ్లేషణలకు ఏదీ పంపబడదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषणासाठी काहीही पाठवले जात नाही"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகுப்பாய்வுக்கு எதுவும் அனுப்பப்படவில்லை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિશ્લેષણમાં કંઈપણ મોકલવામાં આવતું નથી"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಶ್ಲೇಷಣೆಗೆ ಏನನ್ನೂ ಕಳುಹಿಸಲಾಗಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അനലിറ്റിക്‌സിലേക്ക് ഒന്നും അയച്ചിട്ടില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਸ਼ਲੇਸ਼ਣ ਲਈ ਕੁਝ ਵੀ ਨਹੀਂ ਭੇਜਿਆ ਜਾਂਦਾ ਹੈ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est envoyé aux analyses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada a análisis"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم إرسال أي شيء إلى التحليلات"
          }
        }
      }
    },
    "hint_consent_autofill_settings_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To create auto-draft transactions, Android needs one manual step in system settings for notification access. You can change this anytime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो-ड्राफ्ट लेनदेन बनाने के लिए, एंड्रॉइड को अधिसूचना पहुंच के लिए सिस्टम सेटिंग्स में एक मैन्युअल चरण की आवश्यकता होती है। आप इसे कभी भी बदल सकते हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয়-খসড়া লেনদেন তৈরি করতে, Android-এর বিজ্ঞপ্তি অ্যাক্সেসের জন্য সিস্টেম সেটিংসে একটি ম্যানুয়াল ধাপ প্রয়োজন। আপনি যেকোনো সময় এটি পরিবর্তন করতে পারেন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆటో-డ్రాఫ్ట్ లావాదేవీలను సృష్టించడానికి, నోటిఫికేషన్ యాక్సెస్ కోసం సిస్టమ్ సెట్టింగ్‌లలో Androidకి ఒక మాన్యువల్ దశ అవసరం. మీరు దీన్ని ఎప్పుడైనా మార్చవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो-ड्राफ्ट व्यवहार तयार करण्यासाठी, Android ला सूचना प्रवेशासाठी सिस्टम सेटिंग्जमध्ये एक मॅन्युअल चरण आवश्यक आहे. तुम्ही हे कधीही बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கு-வரைவு பரிவர்த்தனைகளை உருவாக்க, அறிவிப்பு அணுகலுக்கான சிஸ்டம் அமைப்புகளில் Androidக்கு ஒரு கைமுறை படி தேவை. இதை நீங்கள் எப்போது வேண்டுமானாலும் மாற்றலாம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વતઃ-ડ્રાફ્ટ વ્યવહારો બનાવવા માટે, Android ને સૂચના ઍક્સેસ માટે સિસ્ટમ સેટિંગ્સમાં એક મેન્યુઅલ પગલાની જરૂર છે. તમે આને કોઈપણ સમયે બદલી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂ-ಡ್ರಾಫ್ಟ್ ವಹಿವಾಟುಗಳನ್ನು ರಚಿಸಲು, ಅಧಿಸೂಚನೆ ಪ್ರವೇಶಕ್ಕಾಗಿ ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Android ಗೆ ಒಂದು ಹಸ್ತಚಾಲಿತ ಹಂತದ ಅಗತ್ಯವಿದೆ. ನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവയുള്ള ഡ്രാഫ്റ്റ് ഇടപാടുകൾ സൃഷ്‌ടിക്കാൻ, അറിയിപ്പ് ആക്‌സസ്സിനായി ആൻഡ്രോയിഡിന് സിസ്റ്റം ക്രമീകരണത്തിൽ ഒരു മാനുവൽ ഘട്ടം ആവശ്യമാണ്. നിങ്ങൾക്ക് ഇത് എപ്പോൾ വേണമെങ്കിലും മാറ്റാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਟੋ-ਡਰਾਫਟ ਲੈਣ-ਦੇਣ ਬਣਾਉਣ ਲਈ, Android ਨੂੰ ਸੂਚਨਾ ਪਹੁੰਚ ਲਈ ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇੱਕ ਹੱਥੀਂ ਕਦਮ ਦੀ ਲੋੜ ਹੁੰਦੀ ਹੈ। ਤੁਸੀਂ ਇਸਨੂੰ ਕਿਸੇ ਵੀ ਸਮੇਂ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour créer des transactions rédigées automatiquement, Android nécessite une étape manuelle dans les paramètres système pour l'accès aux notifications. Vous pouvez modifier cela à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para crear transacciones de borrador automático, Android necesita un paso manual en la configuración del sistema para acceder a las notificaciones. Puedes cambiar esto en cualquier momento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإنشاء معاملات مسودة تلقائية، يحتاج Android إلى خطوة يدوية واحدة في إعدادات النظام للوصول إلى الإشعارات. يمكنك تغيير هذا في أي وقت."
          }
        }
      }
    },
    "hint_consent_autofill_settings_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable auto-fill access"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतः-भरण पहुंच सक्षम करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অটো-ফিল অ্যাক্সেস সক্ষম করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆటో-ఫిల్ యాక్సెస్‌ని ప్రారంభించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयं-भरण प्रवेश सक्षम करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கு நிரப்பு அணுகலை இயக்கு"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વતઃ-ભરણ ઍક્સેસ સક્ષમ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂ ಭರ್ತಿ ಪ್ರವೇಶವನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവ പൂരിപ്പിക്കൽ ആക്‌സസ് പ്രവർത്തനക്ഷമമാക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਟੋ-ਫਿਲ ਪਹੁੰਚ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l'accès au remplissage automatique"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar el acceso de autocompletar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين الوصول إلى الملء التلقائي"
          }
        }
      }
    },
    "hint_consent_autofill_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-fill from bank alerts"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंक अलर्ट से स्वतः भरें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাঙ্ক সতর্কতা থেকে স্বয়ংক্রিয়ভাবে পূরণ করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాంక్ హెచ్చరికల నుండి స్వయంచాలకంగా పూరించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बँक अलर्टमधून ऑटो-फिल"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வங்கி விழிப்பூட்டல்களில் இருந்து தானாக நிரப்பவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બેંક ચેતવણીઓમાંથી સ્વતઃ ભરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ಯಾಂಕ್ ಎಚ್ಚರಿಕೆಗಳಿಂದ ಸ್ವಯಂ ಭರ್ತಿ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാങ്ക് അലേർട്ടുകളിൽ നിന്ന് സ്വയമേവ പൂരിപ്പിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੈਂਕ ਚੇਤਾਵਨੀਆਂ ਤੋਂ ਆਟੋ-ਫਿਲ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissage automatique à partir des alertes bancaires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocompletar desde alertas bancarias"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملء التلقائي من التنبيهات المصرفية"
          }
        }
      }
    },
