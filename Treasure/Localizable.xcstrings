    "hint_app_tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know Your Money. Own Your Future"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पैसे को जानें. अपना भविष्य खुद बनाएं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার টাকা জানুন. আপনার ভবিষ্যতের মালিক"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డబ్బు తెలుసుకోండి. మీ భవిష్యత్తును స్వంతం చేసుకోండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपले पैसे जाणून घ्या. आपल्या भविष्याचे मालक"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பணத்தை அறிந்து கொள்ளுங்கள். உங்கள் எதிர்காலத்தை சொந்தமாக்குங்கள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પૈસા જાણો. તમારા ભવિષ્યના માલિક"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹಣವನ್ನು ತಿಳಿಯಿರಿ. ನಿಮ್ಮ ಭವಿಷ್ಯವನ್ನು ಹೊಂದಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പണം അറിയുക. നിങ്ങളുടെ ഭാവി സ്വന്തമാക്കൂ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਪੈਸੇ ਨੂੰ ਜਾਣੋ। ਆਪਣੇ ਭਵਿੱਖ ਦੇ ਮਾਲਕ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connaissez votre argent. Possédez votre avenir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conozca su dinero. Sea dueño de su futuro"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرف على أموالك. امتلك مستقبلك"
          }
        }
      }
    },
