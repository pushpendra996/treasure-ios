        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓപ്ഷണൽ - എപ്പോൾ വേണമെങ്കിലും ഒഴിവാക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਕਲਪਿਕ — ਕਿਸੇ ਵੀ ਸਮੇਂ ਛੱਡੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
