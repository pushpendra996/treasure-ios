    "hint_consent_setup_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional setup — you can change this anytime"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक सेटअप - आप इसे किसी भी समय बदल सकते हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক সেটআপ — আপনি যেকোনো সময় এটি পরিবর্তন করতে পারেন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐచ్ఛిక సెటప్ - మీరు దీన్ని ఎప్పుడైనా మార్చవచ్చు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी सेटअप — तुम्ही हे कधीही बदलू शकता"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்ப அமைப்பு - இதை எப்போது வேண்டுமானாலும் மாற்றலாம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈકલ્પિક સેટઅપ — તમે આને ગમે ત્યારે બદલી શકો છો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಚ್ಛಿಕ ಸೆಟಪ್ - ನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓപ്ഷണൽ സജ്ജീകരണം - നിങ്ങൾക്ക് ഇത് എപ്പോൾ വേണമെങ്കിലും മാറ്റാം"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਕਲਪਿਕ ਸੈੱਟਅੱਪ — ਤੁਸੀਂ ਇਸਨੂੰ ਕਿਸੇ ਵੀ ਸਮੇਂ ਬਦਲ ਸਕਦੇ ਹੋ"
          }
        },
        "fr": {
