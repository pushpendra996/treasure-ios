    "hint_auth_token_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not get auth token"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरण टोकन नहीं मिल सका"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রমাণীকরণ টোকেন পাওয়া যায়নি"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రామాణీకరణ టోకెన్‌ని పొందడం సాధ్యపడలేదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरण टोकन मिळू शकले नाही"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அங்கீகார டோக்கனைப் பெற முடியவில்லை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓથ ટોકન મેળવી શકાયું નથી"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೃಢೀಕರಣ ಟೋಕನ್ ಪಡೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓത്ത് ടോക്കൺ നേടാനായില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਮਾਣਿਕਤਾ ਟੋਕਨ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir le jeton d'authentification"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener el token de autenticación"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الحصول على رمز المصادقة"
          }
        }
      }
    },
