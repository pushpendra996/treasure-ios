    "hint_please_enter_mobile_number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter valid mobile number"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया वैध मोबाइल नंबर दर्ज करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৈধ মোবাইল নম্বর লিখুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి చెల్లుబాటు అయ్యే మొబైల్ నంబర్‌ని నమోదు చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया वैध मोबाइल नंबर प्रविष्ट करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான மொபைல் எண்ணை உள்ளிடவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૃપા કરીને માન્ય મોબાઇલ નંબર દાખલ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ಮಾನ್ಯವಾದ ಮೊಬೈಲ್ ಸಂಖ್ಯೆಯನ್ನು ನಮೂದಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദയവായി സാധുവായ മൊബൈൽ നമ്പർ നൽകുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਰਪਾ ਕਰਕੇ ਵੈਧ ਮੋਬਾਈਲ ਨੰਬਰ ਦਾਖਲ ਕਰੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez entrer un numéro de mobile valide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor introduce un número de móvil válido"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء إدخال رقم جوال صالح"
          }
        }
      }
    },
    "hint_please_log_in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please log in"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया लॉगिन करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগ ইন করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి లాగిన్ అవ్వండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया लॉग इन करा"
          }
        },
        "ta": {
