        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृत: %1$.2f · लंबित: %2$.2f · अस्वीकृत आइटम: %3$d"
          }
        },
        "bn": {
          "stringUnit": {
