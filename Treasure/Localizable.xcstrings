    "hint_language_change_anytime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change the language anytime from app settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऐप सेटिंग से कभी भी भाषा बदल सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অ্যাপ সেটিংস থেকে যেকোনো সময় ভাষা পরিবর্তন করতে পারেন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు యాప్ సెట్టింగ్‌ల నుండి ఎప్పుడైనా భాషను మార్చవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ॲप सेटिंग्जमधून कधीही भाषा बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்பாட்டு அமைப்புகளில் எந்த நேரத்திலும் மொழியை மாற்றலாம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે એપ્લિકેશન સેટિંગ્સમાંથી કોઈપણ સમયે ભાષા બદલી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್ಲಿಕೇಶನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಭಾಷೆಯನ್ನು ಬದಲಾಯಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ക്രമീകരണത്തിൽ നിന്ന് നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും ഭാഷ മാറ്റാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਐਪ ਸੈਟਿੰਗਾਂ ਤੋਂ ਕਿਸੇ ਵੀ ਸਮੇਂ ਭਾਸ਼ਾ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer la langue à tout moment depuis les paramètres de l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede cambiar el idioma en cualquier momento desde la configuración de la aplicación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير اللغة في أي وقت من إعدادات التطبيق."
          }
        }
      }
    },
