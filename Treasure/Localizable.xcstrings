            "value": "लॉग आउट"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগআউট"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాగ్అవుట్"
          }
        },
        "mr": {
          "stringUnit": {
