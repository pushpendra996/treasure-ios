    "hint_remove_member_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this member from the group?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सदस्य को समूह से निकालें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সদস্যকে গ্রুপ থেকে সরিয়ে দেবেন?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సభ్యుడిని గ్రూప్ నుండి తీసివేయాలా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या सदस्याला गटातून काढून टाकायचे?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுப்பினரை குழுவிலிருந்து அகற்றவா?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સભ્યને જૂથમાંથી દૂર કરીએ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುಂಪಿನಿಂದ ಈ ಸದಸ್ಯರನ್ನು ತೆಗೆದುಹಾಕುವುದೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അംഗത്തെ ഗ്രൂപ്പിൽ നിന്ന് നീക്കം ചെയ്യണോ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਇਸ ਮੈਂਬਰ ਨੂੰ ਗਰੁੱਪ ਵਿੱਚੋਂ ਹਟਾਉਣਾ ਹੈ?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce membre du groupe ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar a este miembro del grupo?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب في إزالة هذا العضو من المجموعة؟"
          }
        }
      }
    },
