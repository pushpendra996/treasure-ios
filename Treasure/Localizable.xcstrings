    "hint_report_based_on_saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your saved transactions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सहेजे गए लेनदेन के आधार पर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সংরক্ষিত লেনদেনের উপর ভিত্তি করে"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సేవ్ చేసిన లావాదేవీల ఆధారంగా"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या सेव्ह केलेल्या व्यवहारांवर आधारित"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சேமித்த பரிவர்த்தனைகளின் அடிப்படையில்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા સાચવેલા વ્યવહારો પર આધારિત"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಉಳಿಸಿದ ವಹಿವಾಟುಗಳನ್ನು ಆಧರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സംരക്ഷിച്ച ഇടപാടുകളെ അടിസ്ഥാനമാക്കി"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸੁਰੱਖਿਅਤ ਕੀਤੇ ਲੈਣ-ਦੇਣ ਦੇ ਆਧਾਰ 'ਤੇ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basé sur vos transactions enregistrées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en sus transacciones guardadas"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بناءً على معاملاتك المحفوظة"
          }
        }
      }
    },
    "hint_report_chart_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show for this period."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अवधि के लिए दिखाने के लिए कुछ भी नहीं है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সময়ের জন্য কিছু দেখানোর জন্য."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కాలానికి చూపించడానికి ఏమీ లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या कालावधीसाठी दर्शविण्यासाठी काहीही नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் காலக்கட்டத்தில் காட்டுவதற்கு எதுவும் இல்லை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સમયગાળા માટે બતાવવા માટે કંઈ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಅವಧಿಗೆ ತೋರಿಸಲು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ കാലയളവിൽ ഒന്നും കാണിക്കാനില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮਿਆਦ ਲਈ ਦਿਖਾਉਣ ਲਈ ਕੁਝ ਨਹੀਂ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à montrer pour cette période."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que mostrar para este período."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لإظهاره لهذه الفترة."
          }
        }
      }
    },
    "hint_report_no_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transactions for this year yet. Add income and expenses to see your charts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्ष के लिए अभी तक कोई लेन-देन नहीं. अपने चार्ट देखने के लिए आय और व्यय जोड़ें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বছরের জন্য এখনও কোন লেনদেন. আপনার চার্ট দেখতে আয় এবং খরচ যোগ করুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఏడాదికి ఇంకా లావాదేవీలు లేవు. మీ చార్ట్‌లను చూడటానికి ఆదాయం మరియు ఖర్చులను జోడించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वर्षासाठी अद्याप कोणतेही व्यवहार झाले नाहीत. तुमचे चार्ट पाहण्यासाठी उत्पन्न आणि खर्च जोडा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆண்டுக்கான பரிவர்த்தனைகள் எதுவும் இல்லை. உங்கள் விளக்கப்படங்களைப் பார்க்க வருமானம் மற்றும் செலவுகளைச் சேர்க்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વર્ષ માટે હજુ સુધી કોઈ વ્યવહારો નથી. તમારા ચાર્ટ જોવા માટે આવક અને ખર્ચ ઉમેરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವರ್ಷಕ್ಕೆ ಇನ್ನೂ ಯಾವುದೇ ವಹಿವಾಟು ನಡೆದಿಲ್ಲ. ನಿಮ್ಮ ಚಾರ್ಟ್‌ಗಳನ್ನು ನೋಡಲು ಆದಾಯ ಮತ್ತು ವೆಚ್ಚಗಳನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വർഷം ഇതുവരെ ഇടപാടുകളൊന്നുമില്ല. നിങ്ങളുടെ ചാർട്ടുകൾ കാണുന്നതിന് വരുമാനവും ചെലവും ചേർക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਸਾਲ ਲਈ ਅਜੇ ਤੱਕ ਕੋਈ ਲੈਣ-ਦੇਣ ਨਹੀਂ ਹੋਇਆ। ਆਪਣੇ ਚਾਰਟ ਦੇਖਣ ਲਈ ਆਮਦਨ ਅਤੇ ਖਰਚੇ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transaction pour cette année encore. Ajoutez des revenus et des dépenses pour voir vos graphiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay transacciones para este año. Agregue ingresos y gastos para ver sus gráficos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد معاملات لهذا العام حتى الآن. أضف الدخل والنفقات لرؤية الرسوم البيانية الخاصة بك."
          }
        }
      }
    },
