    "hint_otp_resend_des": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't Receive Code? Resend"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड प्राप्त नहीं हुआ? पुनः भेजें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোড পাননি? পুনরায় পাঠান"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోడ్ అందలేదా? మళ్లీ పంపండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड प्राप्त झाला नाही? पुन्हा पाठवा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறியீட்டைப் பெறவில்லையா? மீண்டும் அனுப்பு"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોડ પ્રાપ્ત થયો નથી? ફરીથી મોકલો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೋಡ್ ಸ್ವೀಕರಿಸಲಿಲ್ಲವೇ? ಮರುಕಳುಹಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോഡ് ലഭിച്ചില്ലേ? വീണ്ടും അയയ്‌ക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਕੋਡ ਪ੍ਰਾਪਤ ਨਹੀਂ ਹੋਇਆ? ਮੁੜ ਭੇਜੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas reçu le code ? Renvoyer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No recibió el código? Reenviar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتلق الرمز؟ إعادة الإرسال"
          }
        }
      }
    },
    "hint_otp_resend_timer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP resend in %1$@"
