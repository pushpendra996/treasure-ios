    "hint_add_member_sheet_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same country code and number they use in Treasure so they can see this group in the app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी देश कोड और नंबर का उपयोग करें जिसका उपयोग वे ट्रेज़र में करते हैं ताकि वे इस समूह को ऐप में देख सकें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারা ট্রেজারে যে দেশের কোড এবং নম্বর ব্যবহার করে সেই একই দেশের কোড ব্যবহার করুন যাতে তারা অ্যাপটিতে এই গ্রুপটি দেখতে পারে।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రెజర్‌లో వారు ఉపయోగించే అదే దేశం కోడ్ మరియు నంబర్‌ను ఉపయోగించండి, తద్వారా వారు యాప్‌లో ఈ సమూహాన్ని చూడగలరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते ट्रेझरमध्ये वापरतात तोच देश कोड आणि क्रमांक वापरा जेणेकरून ते ॲपमध्ये हा गट पाहू शकतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ட்ரெஷரில் அவர்கள் பயன்படுத்தும் அதே நாட்டின் குறியீடு மற்றும் எண்ணைப் பயன்படுத்தவும், இதன் மூலம் அவர்கள் இந்த குழுவை பயன்பாட்டில் பார்க்க முடியும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેઓ જે દેશનો કોડ અને નંબર ટ્રેઝરમાં વાપરે છે તેનો ઉપયોગ કરો જેથી તેઓ આ જૂથને એપ્લિકેશનમાં જોઈ શકે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವರು ಟ್ರೆಷರ್‌ನಲ್ಲಿ ಬಳಸುವ ಅದೇ ದೇಶದ ಕೋಡ್ ಮತ್ತು ಸಂಖ್ಯೆಯನ್ನು ಬಳಸಿ ಇದರಿಂದ ಅವರು ಈ ಗುಂಪನ್ನು ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ನೋಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രഷറിൽ അവർ ഉപയോഗിക്കുന്ന അതേ രാജ്യ കോഡും നമ്പറും ഉപയോഗിക്കുക, അതുവഴി അവർക്ക് ആപ്പിൽ ഈ ഗ്രൂപ്പ് കാണാൻ കഴിയും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹੀ ਦੇਸ਼ ਕੋਡ ਅਤੇ ਨੰਬਰ ਵਰਤੋ ਜੋ ਉਹ ਖਜ਼ਾਨੇ ਵਿੱਚ ਵਰਤਦੇ ਹਨ ਤਾਂ ਜੋ ਉਹ ਐਪ ਵਿੱਚ ਇਸ ਸਮੂਹ ਨੂੰ ਦੇਖ ਸਕਣ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le même code de pays et le même numéro qu'ils utilisent dans Treasure afin qu'ils puissent voir ce groupe dans l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el mismo código de país y número que utilizan en Treasure para que puedan ver este grupo en la aplicación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم نفس رمز البلد والرقم الذي يستخدمونه في Treasure حتى يتمكنوا من رؤية هذه المجموعة في التطبيق."
          }
        }
      }
    },
