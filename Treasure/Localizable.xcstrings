            "value": "অনুমোদিত: %1$.2f · মুলতুবি: %2$.2f · প্রত্যাখ্যাত আইটেম: %3$d"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆమోదించబడింది: %1$.2f · పెండింగ్‌లో ఉంది: %2$.2f · తిరస్కరించబడిన అంశాలు: %3$d"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मंजूर: %1$.2f · प्रलंबित: %2$.2f · नाकारलेले आयटम: %3$d"
          }
        },
        "ta": {
          "stringUnit": {
