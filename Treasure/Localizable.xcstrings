    "hint_consent_alerts_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay on top of your spending with gentle reminders to log expenses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्चों को लॉग करने के लिए सौम्य अनुस्मारक के साथ अपने खर्च पर नियंत्रण रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খরচ লগ করার জন্য মৃদু অনুস্মারক সহ আপনার ব্যয়ের শীর্ষে থাকুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖర్చులను లాగ్ చేయడానికి సున్నితమైన రిమైండర్‌లతో మీ ఖర్చుపై అగ్రస్థానంలో ఉండండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च लॉग करण्यासाठी सौम्य स्मरणपत्रांसह आपल्या खर्चाच्या शीर्षस्थानी रहा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செலவினங்களைப் பதிவுசெய்வதற்கான மென்மையான நினைவூட்டல்களுடன் உங்கள் செலவினங்களின் மேல் இருக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખર્ચ લોગ કરવા માટે હળવા રીમાઇન્ડર્સ સાથે તમારા ખર્ચમાં ટોચ પર રહો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೆಚ್ಚಗಳನ್ನು ಲಾಗ್ ಮಾಡಲು ಸೌಮ್ಯವಾದ ಜ್ಞಾಪನೆಗಳೊಂದಿಗೆ ನಿಮ್ಮ ಖರ್ಚಿನ ಮೇಲೆ ಉಳಿಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെലവുകൾ ലോഗ് ചെയ്യാനുള്ള സൌമ്യമായ ഓർമ്മപ്പെടുത്തലുകളോടെ നിങ്ങളുടെ ചെലവിൻ്റെ മുകളിൽ തുടരുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖਰਚਿਆਂ ਨੂੰ ਲੌਗ ਕਰਨ ਲਈ ਕੋਮਲ ਰੀਮਾਈਂਡਰਾਂ ਨਾਲ ਆਪਣੇ ਖਰਚਿਆਂ ਦੇ ਸਿਖਰ 'ਤੇ ਰਹੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez au courant de vos dépenses grâce à de doux rappels pour enregistrer vos dépenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manténgase al tanto de sus gastos con recordatorios suaves para registrarlos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابق على اطلاع على إنفاقك من خلال التذكيرات اللطيفة لتسجيل النفقات."
          }
        }
      }
    },
    "hint_consent_alerts_point1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily expense reminders"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनिक व्यय अनुस्मारक"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দৈনিক খরচ অনুস্মারক"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజువారీ ఖర్చు రిమైండర్లు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनंदिन खर्चाचे स्मरणपत्र"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தினசரி செலவு நினைவூட்டல்கள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દૈનિક ખર્ચ રીમાઇન્ડર્સ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೈನಂದಿನ ಖರ್ಚು ಜ್ಞಾಪನೆಗಳು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദൈനംദിന ചെലവ് ഓർമ്മപ്പെടുത്തലുകൾ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੋਜ਼ਾਨਾ ਖਰਚੇ ਰੀਮਾਈਂਡਰ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels de dépenses quotidiens"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios de gastos diarios"
          }
        },
        "ar": {
