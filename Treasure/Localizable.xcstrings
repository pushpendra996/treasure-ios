        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাঙ্ক সতর্কতা থেকে স্বয়ংক্রিয়ভাবে পূরণ করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాంక్ హెచ్చరికల నుండి స్వయంచాలకంగా పూరించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बँक अलर्टमधून ऑटो-फिल"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வங்கி விழிப்பூட்டல்களில் இருந்து தானாக நிரப்பவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બેંક ચેતવણીઓમાંથી સ્વતઃ ભરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ಯಾಂಕ್ ಎಚ್ಚರಿಕೆಗಳಿಂದ ಸ್ವಯಂ ಭರ್ತಿ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാങ്ക് അലേർട്ടുകളിൽ നിന്ന് സ്വയമേവ പൂരിപ്പിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੈਂਕ ਚੇਤਾਵਨੀਆਂ ਤੋਂ ਆਟੋ-ਫਿਲ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissage automatique à partir des alertes bancaires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocompletar desde alertas bancarias"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملء التلقائي من التنبيهات المصرفية"
          }
        }
      }
    },
    "hint_permission_autofill_sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft entries from bank alerts"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंक अलर्ट से ड्राफ्ट प्रविष्टियाँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাঙ্ক সতর্কতা থেকে খসড়া এন্ট্রি"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాంక్ హెచ్చరికల నుండి డ్రాఫ్ట్ ఎంట్రీలు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बँक अलर्टमधून मसुदा नोंदी"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வங்கி விழிப்பூட்டல்களில் இருந்து வரைவு உள்ளீடுகள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બેંક ચેતવણીઓમાંથી ડ્રાફ્ટ એન્ટ્રીઓ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ಯಾಂಕ್ ಎಚ್ಚರಿಕೆಗಳಿಂದ ಡ್ರಾಫ್ಟ್ ನಮೂದುಗಳು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാങ്ക് അലേർട്ടുകളിൽ നിന്നുള്ള ഡ്രാഫ്റ്റ് എൻട്രികൾ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੈਂਕ ਅਲਰਟ ਤੋਂ ਡਰਾਫਟ ਐਂਟਰੀਆਂ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger des écritures à partir d'alertes bancaires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borradores de entradas de alertas bancarias"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشروع إدخالات من التنبيهات المصرفية"
          }
        }
      }
    },
    "hint_permission_center_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional features. You stay in control and can change anytime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक सुविधाएँ. आप नियंत्रण में रहते हैं और कभी भी बदल सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক বৈশিষ্ট্য. আপনি নিয়ন্ত্রণে থাকুন এবং যেকোনো সময় পরিবর্তন করতে পারেন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐచ్ఛిక లక్షణాలు. మీరు నియంత్రణలో ఉంటారు మరియు ఎప్పుడైనా మార్చవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी वैशिष्ट्ये. तुम्ही नियंत्रणात रहा आणि कधीही बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்ப அம்சங்கள். நீங்கள் கட்டுப்பாட்டில் இருங்கள் மற்றும் எப்போது வேண்டுமானாலும் மாற்றலாம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈકલ્પિક સુવિધાઓ. તમે નિયંત્રણમાં રહો છો અને કોઈપણ સમયે બદલી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಚ್ಛಿಕ ವೈಶಿಷ್ಟ್ಯಗಳು. ನೀವು ನಿಯಂತ್ರಣದಲ್ಲಿರುತ್ತೀರಿ ಮತ್ತು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓപ്ഷണൽ സവിശേഷതകൾ. നിങ്ങൾ നിയന്ത്രണത്തിൽ തുടരുകയും എപ്പോൾ വേണമെങ്കിലും മാറ്റുകയും ചെയ്യാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਕਲਪਿਕ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ। ਤੁਸੀਂ ਕੰਟਰੋਲ ਵਿੱਚ ਰਹਿੰਦੇ ਹੋ ਅਤੇ ਕਿਸੇ ਵੀ ਸਮੇਂ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionnalités facultatives. Vous gardez le contrôle et pouvez changer à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Características opcionales. Usted mantiene el control y puede cambiar en cualquier momento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزات اختيارية. يمكنك البقاء مسيطرًا ويمكنك التغيير في أي وقت."
          }
        }
      }
    },
    "hint_permission_center_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission controls"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति नियंत्रण"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি নিয়ন্ত্রণ"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనుమతి నియంత్రణలు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परवानगी नियंत्रणे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுமதி கட்டுப்பாடுகள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરવાનગી નિયંત્રણો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮತಿ ನಿಯಂತ್ರಣಗಳು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അനുമതി നിയന്ത്രണങ്ങൾ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਨੁਮਤੀ ਨਿਯੰਤਰਣ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôles d'autorisation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles de permisos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضوابط الأذونات"
          }
        }
      }
    },
    "hint_permission_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off — tap to enable"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद - सक्षम करने के लिए टैप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ - সক্ষম করতে আলতো চাপুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్ - ఎనేబుల్ చేయడానికి నొక్కండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद — सक्षम करण्यासाठी टॅप करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆஃப் - இயக்க தட்டவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બંધ - સક્ષમ કરવા માટે ટેપ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಫ್ - ಸಕ್ರಿಯಗೊಳಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ് - പ്രവർത്തനക്ഷമമാക്കാൻ ടാപ്പുചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੰਦ — ਯੋਗ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : appuyez pour activer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: toque para habilitar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف — انقر للتمكين"
          }
        }
      }
    },
    "hint_permission_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On — tap to manage"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू - प्रबंधित करने के लिए टैप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু — পরিচালনা করতে আলতো চাপুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆన్ - నిర్వహించడానికి నొక్కండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू — व्यवस्थापित करण्यासाठी टॅप करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆன் - நிர்வகிக்க தட்டவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ — મેનેજ કરવા માટે ટૅપ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್ - ನಿರ್ವಹಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺ - മാനേജ് ചെയ്യാൻ ടാപ്പ് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚਾਲੂ — ਪ੍ਰਬੰਧਨ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : appuyez pour gérer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: toca para administrar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل - انقر للإدارة"
          }
        }
      }
    },
