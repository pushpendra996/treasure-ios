      }
    },
    "hint_close_group_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this group? Members will not be able to add, edit, or remove expenses and members."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समूह को बंद करें? सदस्य खर्चों और सदस्यों को जोड़, संपादित या हटा नहीं सकेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গ্রুপ বন্ধ করবেন? সদস্যরা খরচ এবং সদস্য যোগ, সম্পাদনা বা অপসারণ করতে সক্ষম হবে না।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సమూహాన్ని మూసివేయాలా? సభ్యులు ఖర్చులు మరియు సభ్యులను జోడించలేరు, సవరించలేరు లేదా తీసివేయలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा गट बंद करायचा? सदस्य खर्च आणि सदस्य जोडू, संपादित करू किंवा काढू शकणार नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குழுவை மூடவா? உறுப்பினர்களால் செலவுகள் மற்றும் உறுப்பினர்களைச் சேர்க்கவோ, திருத்தவோ அல்லது அகற்றவோ முடியாது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ જૂથ બંધ કરીએ? સભ્યો ખર્ચ અને સભ્યોને ઉમેરી, સંપાદિત અથવા દૂર કરી શકશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗುಂಪನ್ನು ಮುಚ್ಚುವುದೇ? ಸದಸ್ಯರು ವೆಚ್ಚಗಳು ಮತ್ತು ಸದಸ್ಯರನ್ನು ಸೇರಿಸಲು, ಸಂಪಾದಿಸಲು ಅಥವಾ ತೆಗೆದುಹಾಕಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഗ്രൂപ്പ് അടയ്‌ക്കണോ? അംഗങ്ങൾക്ക് ചെലവുകളും അംഗങ്ങളും ചേർക്കാനോ എഡിറ്റ് ചെയ്യാനോ നീക്കം ചെയ്യാനോ കഴിയില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਇਸ ਸਮੂਹ ਨੂੰ ਬੰਦ ਕਰਨਾ ਹੈ? ਮੈਂਬਰ ਖਰਚਿਆਂ ਅਤੇ ਮੈਂਬਰਾਂ ਨੂੰ ਜੋੜਨ, ਸੰਪਾਦਿਤ ਕਰਨ ਜਾਂ ਹਟਾਉਣ ਦੇ ਯੋਗ ਨਹੀਂ ਹੋਣਗੇ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer ce groupe ? Les membres ne pourront pas ajouter, modifier ou supprimer des dépenses et des membres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar este grupo? Los miembros no podrán agregar, editar ni eliminar gastos ni miembros."
          }
        },
        "ar": {
          "stringUnit": {
