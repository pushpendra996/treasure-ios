    "hint_transaction_option": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to do with this transaction?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस लेन-देन के साथ क्या करना चाहते हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই লেনদেন দিয়ে কি করতে চান?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈ లావాదేవీని ఏమి చేయాలనుకుంటున్నారు?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला या व्यवहाराचे काय करायचे आहे?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பரிவர்த்தனையை என்ன செய்ய விரும்புகிறீர்கள்?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે આ વ્યવહાર સાથે શું કરવા માંગો છો?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವಹಿವಾಟನ್ನು ನೀವು ಏನು ಮಾಡಲು ಬಯಸುತ್ತೀರಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇടപാടുമായി നിങ്ങൾ എന്താണ് ചെയ്യാൻ ആഗ്രഹിക്കുന്നത്?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸ ਲੈਣ-ਦੇਣ ਨਾਲ ਕੀ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous faire de cette transaction ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres hacer con esta transacción?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن تفعل بهذه الصفقة؟"
          }
        }
      }
    },
