    "expense_reminder_channel_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twice-daily reminders to log expenses so your month-end report stays accurate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्चों को लॉग करने के लिए दिन में दो बार अनुस्मारक दें ताकि आपकी महीने के अंत की रिपोर्ट सटीक बनी रहे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খরচ লগ করার জন্য প্রতিদিন দুবার অনুস্মারক যাতে আপনার মাস-শেষের রিপোর্ট সঠিক থাকে।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖర్చులను లాగ్ చేయడానికి రోజుకు రెండుసార్లు రిమైండర్‌లు తద్వారా మీ నెలాఖరు నివేదిక ఖచ్చితంగా ఉంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च लॉग करण्यासाठी दररोज दोनदा स्मरणपत्रे जेणेकरून तुमचा महिना-अखेरचा अहवाल अचूक राहील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மாத இறுதி அறிக்கை துல்லியமாக இருக்க, செலவுகளை பதிவு செய்ய தினசரி இருமுறை நினைவூட்டல்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખર્ચને લૉગ કરવા માટે દરરોજ બે વાર રીમાઇન્ડર્સ જેથી તમારો મહિનાના અંતનો રિપોર્ટ સચોટ રહે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೆಚ್ಚಗಳನ್ನು ಲಾಗ್ ಮಾಡಲು ದಿನಕ್ಕೆ ಎರಡು ಬಾರಿ ಜ್ಞಾಪನೆಗಳು ಆದ್ದರಿಂದ ನಿಮ್ಮ ತಿಂಗಳ ಅಂತ್ಯದ ವರದಿಯು ನಿಖರವಾಗಿರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മാസാവസാന റിപ്പോർട്ട് കൃത്യമായി നിലനിൽക്കാൻ ചെലവുകൾ ലോഗ് ചെയ്യുന്നതിനുള്ള ദിവസേന രണ്ടുതവണ ഓർമ്മപ്പെടുത്തലുകൾ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖਰਚਿਆਂ ਨੂੰ ਲੌਗ ਕਰਨ ਲਈ ਰੋਜ਼ਾਨਾ ਦੋ ਵਾਰ ਰੀਮਾਈਂਡਰ ਤਾਂ ਜੋ ਤੁਹਾਡੀ ਮਹੀਨੇ ਦੇ ਅੰਤ ਦੀ ਰਿਪੋਰਟ ਸਹੀ ਰਹੇ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels deux fois par jour pour enregistrer les dépenses afin que votre rapport de fin de mois reste précis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios dos veces al día para registrar los gastos para que su informe de fin de mes se mantenga preciso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات مرتين يوميًا لتسجيل النفقات حتى يظل تقرير نهاية الشهر دقيقًا."
          }
        }
      }
    },
