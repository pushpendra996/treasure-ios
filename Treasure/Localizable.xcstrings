        }
      }
    },
    "hint_no_cached_month": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cached data for this month"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने के लिए कोई कैश्ड डेटा नहीं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসের জন্য কোনো ক্যাশে ডেটা নেই"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నెల కోసం కాష్ చేసిన డేటా లేదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या महिन्यासाठी कोणताही कॅश केलेला डेटा नाही"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதத்திற்கான தற்காலிக சேமிப்பு தரவு இல்லை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ મહિના માટે કોઈ કેશ્ડ ડેટા નથી"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ತಿಂಗಳಿಗೆ ಯಾವುದೇ ಕ್ಯಾಶ್ ಮಾಡಲಾದ ಡೇಟಾ ಇಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാസത്തേക്ക് കാഷെ ചെയ്ത ഡാറ്റകളൊന്നുമില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮਹੀਨੇ ਲਈ ਕੋਈ ਕੈਸ਼ ਡਾਟਾ ਨਹੀਂ ਹੈ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée en cache pour ce mois"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos almacenados en caché para este mes"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بيانات مخزنة مؤقتا لهذا الشهر"
          }
        }
      }
    },
    "hint_no_category_found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
