          }
        }
      }
    },
    "hint_logout_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out to end your session. You will need to log in again to access your financial data."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना सत्र समाप्त करने के लिए लॉग आउट करें। अपने वित्तीय डेटा तक पहुंचने के लिए आपको फिर से लॉग इन करना होगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সেশন শেষ করতে লগ আউট করুন. আপনার আর্থিক ডেটা অ্যাক্সেস করতে আপনাকে আবার লগ ইন করতে হবে।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సెషన్‌ను ముగించడానికి లాగ్ అవుట్ చేయండి. మీ ఆర్థిక డేటాను యాక్సెస్ చేయడానికి మీరు మళ్లీ లాగిన్ చేయాలి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे सत्र समाप्त करण्यासाठी लॉग आउट करा. तुमच्या आर्थिक डेटामध्ये प्रवेश करण्यासाठी तुम्हाला पुन्हा लॉग इन करावे लागेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அமர்வை முடிக்க வெளியேறவும். உங்கள் நிதித் தரவை அணுக மீண்டும் உள்நுழைய வேண்டும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું સત્ર સમાપ્ત કરવા માટે લૉગ આઉટ કરો. તમારા નાણાકીય ડેટાને ઍક્સેસ કરવા માટે તમારે ફરીથી લૉગ ઇન કરવાની જરૂર પડશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಅಧಿವೇಶನವನ್ನು ಕೊನೆಗೊಳಿಸಲು ಲಾಗ್ ಔಟ್ ಮಾಡಿ. ನಿಮ್ಮ ಹಣಕಾಸಿನ ಡೇಟಾವನ್ನು ಪ್ರವೇಶಿಸಲು ನೀವು ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സെഷൻ അവസാനിപ്പിക്കാൻ ലോഗ് ഔട്ട് ചെയ്യുക. നിങ്ങളുടെ സാമ്പത്തിക ഡാറ്റ ആക്‌സസ് ചെയ്യുന്നതിന് നിങ്ങൾ വീണ്ടും ലോഗിൻ ചെയ്യേണ്ടതുണ്ട്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਸੈਸ਼ਨ ਨੂੰ ਖਤਮ ਕਰਨ ਲਈ ਲੌਗ ਆਊਟ ਕਰੋ। ਤੁਹਾਨੂੰ ਆਪਣੇ ਵਿੱਤੀ ਡੇਟਾ ਤੱਕ ਪਹੁੰਚ ਕਰਨ ਲਈ ਦੁਬਾਰਾ ਲੌਗ ਇਨ ਕਰਨ ਦੀ ਲੋੜ ਪਵੇਗੀ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous pour mettre fin à votre session. Vous devrez vous reconnecter pour accéder à vos données financières."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre sesión para finalizar su sesión. Deberá iniciar sesión nuevamente para acceder a sus datos financieros."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الخروج لإنهاء جلستك. سوف تحتاج إلى تسجيل الدخول مرة أخرى للوصول إلى البيانات المالية الخاصة بك."
          }
        }
      }
    },
    "hint_manage_committees_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create auction committees and add members by name and mobile. They will see the committee in the app when their phone number matches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीलामी समितियाँ बनाएँ और सदस्यों को नाम और मोबाइल से जोड़ें। उनका फोन नंबर मैच होने पर उन्हें एप में कमेटी दिखाई देगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিলাম কমিটি তৈরি করুন এবং নাম ও মোবাইলের মাধ্যমে সদস্য যোগ করুন। তাদের ফোন নম্বর মিলে গেলে অ্যাপটিতে কমিটি দেখতে পাবেন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేలం కమిటీలను సృష్టించండి మరియు పేరు మరియు మొబైల్ ద్వారా సభ్యులను జోడించండి. వారి ఫోన్ నంబర్ సరిపోలినప్పుడు వారు యాప్‌లో కమిటీని చూస్తారు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लिलाव समित्या तयार करा आणि नाव आणि मोबाईलद्वारे सदस्य जोडा. त्यांचा फोन नंबर जुळल्यावर त्यांना ॲपमध्ये समिती दिसेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏலக் குழுக்களை உருவாக்கி, பெயர் மற்றும் மொபைல் மூலம் உறுப்பினர்களைச் சேர்க்கவும். அவர்களின் ஃபோன் எண் பொருந்தினால், அவர்கள் செயலியில் குழுவைப் பார்ப்பார்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હરાજી સમિતિઓ બનાવો અને નામ અને મોબાઈલ દ્વારા સભ્યો ઉમેરો. જ્યારે તેમનો ફોન નંબર મેળ ખાશે ત્યારે તેઓ એપમાં સમિતિને જોશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹರಾಜು ಸಮಿತಿಗಳನ್ನು ರಚಿಸಿ ಹೆಸರು ಮತ್ತು ಮೊಬೈಲ್ ಮೂಲಕ ಸದಸ್ಯರನ್ನು ಸೇರಿಸಿ. ಅವರ ಫೋನ್ ಸಂಖ್ಯೆ ಹೊಂದಿಕೆಯಾದಾಗ ಅವರು ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ಸಮಿತಿಯನ್ನು ನೋಡುತ್ತಾರೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലേല കമ്മിറ്റികൾ രൂപീകരിച്ച് പേരും മൊബൈലും ഉപയോഗിച്ച് അംഗങ്ങളെ ചേർക്കുക. അവരുടെ ഫോൺ നമ്പർ പൊരുത്തപ്പെടുമ്പോൾ അവർ ആപ്പിലെ കമ്മിറ്റിയെ കാണും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਲਾਮੀ ਕਮੇਟੀਆਂ ਬਣਾਓ ਅਤੇ ਨਾਮ ਅਤੇ ਮੋਬਾਈਲ ਦੁਆਰਾ ਮੈਂਬਰਾਂ ਨੂੰ ਸ਼ਾਮਲ ਕਰੋ। ਜਦੋਂ ਉਨ੍ਹਾਂ ਦਾ ਫ਼ੋਨ ਨੰਬਰ ਮੇਲ ਖਾਂਦਾ ਹੈ ਤਾਂ ਉਹ ਐਪ ਵਿੱਚ ਕਮੇਟੀ ਨੂੰ ਦੇਖਣਗੇ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des comités d'enchères et ajoutez des membres par nom et mobile. Ils verront le comité dans l'application lorsque leur numéro de téléphone correspondra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree comités de subasta y agregue miembros por nombre y dispositivo móvil. Verán el comité en la aplicación cuando su número de teléfono coincida."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء لجان المزاد وإضافة الأعضاء بالاسم والجوال. سوف يرون اللجنة في التطبيق عندما يتطابق رقم هاتفهم."
          }
        }
      }
    },
    "hint_manage_my_committees_short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create & manage committees"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समितियाँ बनाएँ और प्रबंधित करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমিটি গঠন ও পরিচালনা করুন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కమిటీలను సృష్టించండి & నిర్వహించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समित्या तयार करा आणि व्यवस्थापित करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழுக்களை உருவாக்கி நிர்வகிக்கவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમિતિઓ બનાવો અને તેનું સંચાલન કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮಿತಿಗಳನ್ನು ರಚಿಸಿ ಮತ್ತು ನಿರ್ವಹಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കമ്മിറ്റികൾ സൃഷ്ടിക്കുകയും നിയന്ത്രിക്കുകയും ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਮੇਟੀਆਂ ਬਣਾਓ ਅਤੇ ਪ੍ਰਬੰਧਿਤ ਕਰੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer et gérer des comités"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear y gestionar comités"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء وإدارة اللجان"
          }
        }
      }
    },
    "hint_manage_permissions": {
