          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई श्रेणी नहीं मिली"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো বিভাগ পাওয়া যায়নি"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వర్గం కనుగొనబడలేదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
