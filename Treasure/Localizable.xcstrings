    "hint_consent_alerts_point3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App works fully without this"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप इसके बिना भी पूरी तरह से काम करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি এটি ছাড়া সম্পূর্ণভাবে কাজ করে"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది లేకుండా యాప్ పూర్తిగా పనిచేస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "याशिवाय ॲप पूर्णपणे कार्य करते"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இல்லாமல் பயன்பாடு முழுமையாக வேலை செய்கிறது"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એપ્લિકેશન આ વિના સંપૂર્ણ રીતે કાર્ય કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಇಲ್ಲದೆ ಅಪ್ಲಿಕೇಶನ್ ಸಂಪೂರ್ಣವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതില്ലാതെ ആപ്പ് പൂർണ്ണമായി പ്രവർത്തിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਇਸ ਤੋਂ ਬਿਨਾਂ ਪੂਰੀ ਤਰ੍ਹਾਂ ਕੰਮ ਕਰਦਾ ਹੈ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application fonctionne pleinement sans cela"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación funciona completamente sin esto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق يعمل بشكل كامل بدون هذا"
          }
        }
      }
    },
