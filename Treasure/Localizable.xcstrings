            "value": "ಯಾವುದೇ ವರ್ಗ ಕಂಡುಬಂದಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിഭാഗമൊന്നും കണ്ടെത്തിയില്ല"
