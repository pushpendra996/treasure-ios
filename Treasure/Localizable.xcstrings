        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP %1$@ இல் மீண்டும் அனுப்பப்படும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP %1$@ માં ફરીથી મોકલો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ರಲ್ಲಿ OTP ಮರುಕಳುಹಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP %1$@-ൽ വീണ്ടും അയയ്ക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP %1$@ ਵਿੱਚ ਦੁਬਾਰਾ ਭੇਜੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoi OTP dans %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP reenviar en %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة إرسال كلمة المرور لمرة واحدة (OTP) في %1$@"
          }
        }
      }
    },
    "hint_otp_send_heading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have sent a verification code to"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने एक सत्यापन कोड भेज दिया है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা একটি যাচাইকরণ কোড পাঠিয়েছি"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మేము ధృవీకరణ కోడ్‌ని పంపాము"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही एक पडताळणी कोड पाठवला आहे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதற்கு சரிபார்ப்புக் குறியீட்டை அனுப்பியுள்ளோம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પર અમે ચકાસણી કોડ મોકલ્યો છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾವು ಪರಿಶೀಲನೆ ಕೋಡ್ ಅನ್ನು ಕಳುಹಿಸಿದ್ದೇವೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങൾ ഒരു സ്ഥിരീകരണ കോഡ് അയച്ചു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੂੰ ਇੱਕ ਪੁਸ਼ਟੀਕਰਨ ਕੋਡ ਭੇਜਿਆ ਹੈ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un code de vérification à"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos enviado un código de verificación a"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أرسلنا رمز التحقق إلى"
          }
        }
      }
    },
    "hint_otp_sent_again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP has been sent again on your number"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नंबर पर दोबारा OTP भेजा गया है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নম্বরে আবার ওটিপি পাঠানো হয়েছে"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నంబర్‌కు మళ్లీ OTP పంపబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या नंबरवर OTP पुन्हा पाठवला गेला आहे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் எண்ணுக்கு மீண்டும் OTP அனுப்பப்பட்டுள்ளது"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા નંબર પર ફરીથી OTP મોકલવામાં આવ્યો છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಖ್ಯೆಗೆ ಮತ್ತೆ OTP ಕಳುಹಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നമ്പറിലേക്ക് വീണ്ടും OTP അയച്ചു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਨੰਬਰ 'ਤੇ OTP ਦੁਬਾਰਾ ਭੇਜਿਆ ਗਿਆ ਹੈ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP a été à nouveau envoyé sur votre numéro"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OTP ha sido enviada nuevamente a su número"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال OTP مرة أخرى على رقمك"
          }
        }
      }
    },
