    "hint_expense_sharing_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a group for roommates or friends, add shared expenses, and approve entries as admin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूममेट्स या दोस्तों के लिए एक समूह बनाएं, साझा खर्च जोड़ें, और व्यवस्थापक के रूप में प्रविष्टियों को मंजूरी दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমমেট বা বন্ধুদের জন্য একটি গ্রুপ তৈরি করুন, ভাগ করা খরচ যোগ করুন এবং অ্যাডমিন হিসাবে এন্ট্রি অনুমোদন করুন।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌మేట్‌లు లేదా స్నేహితుల కోసం ఒక సమూహాన్ని సృష్టించండి, షేర్ చేసిన ఖర్చులను జోడించండి మరియు అడ్మిన్‌గా ఎంట్రీలను ఆమోదించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रूममेट किंवा मित्रांसाठी एक गट तयार करा, सामायिक खर्च जोडा आणि ॲडमिन म्हणून एंट्री मंजूर करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ரூம்மேட்கள் அல்லது நண்பர்களுக்காக ஒரு குழுவை உருவாக்கவும், பகிரப்பட்ட செலவுகளைச் சேர்க்கவும் மற்றும் உள்ளீடுகளை நிர்வாகியாக அங்கீகரிக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રૂમમેટ્સ અથવા મિત્રો માટે એક જૂથ બનાવો, વહેંચાયેલ ખર્ચ ઉમેરો અને એડમિન તરીકે એન્ટ્રીઓ મંજૂર કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೂಮ್‌ಮೇಟ್‌ಗಳು ಅಥವಾ ಸ್ನೇಹಿತರಿಗಾಗಿ ಗುಂಪನ್ನು ರಚಿಸಿ, ಹಂಚಿಕೆಯ ವೆಚ್ಚಗಳನ್ನು ಸೇರಿಸಿ ಮತ್ತು ನಿರ್ವಾಹಕರಾಗಿ ನಮೂದುಗಳನ್ನು ಅನುಮೋದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സഹമുറിയന്മാർക്കോ സുഹൃത്തുക്കൾക്കോ ​​വേണ്ടി ഒരു ഗ്രൂപ്പ് സൃഷ്ടിക്കുക, പങ്കിട്ട ചെലവുകൾ ചേർക്കുക, അഡ്മിൻ ആയി എൻട്രികൾ അംഗീകരിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੂਮਮੇਟ ਜਾਂ ਦੋਸਤਾਂ ਲਈ ਇੱਕ ਸਮੂਹ ਬਣਾਓ, ਸਾਂਝੇ ਖਰਚੇ ਸ਼ਾਮਲ ਕਰੋ, ਅਤੇ ਪ੍ਰਸ਼ਾਸਕ ਵਜੋਂ ਐਂਟਰੀਆਂ ਨੂੰ ਮਨਜ਼ੂਰੀ ਦਿਓ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un groupe pour colocataires ou amis, ajoutez des dépenses partagées et approuvez les entrées en tant qu'administrateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree un grupo para compañeros de cuarto o amigos, agregue gastos compartidos y apruebe entradas como administrador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ مجموعة لزملاء السكن أو الأصدقاء، وأضف النفقات المشتركة، ووافق على الإدخالات كمسؤول."
          }
        }
      }
    },
