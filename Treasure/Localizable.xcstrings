    "hint_sharing_expense_submitted_sync": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expense submitted. Also added to your home expense list."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यय प्रस्तुत किया गया। आपके घरेलू व्यय सूची में भी जोड़ा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খরচ জমা দেওয়া হয়েছে। এছাড়াও আপনার বাড়ির খরচ তালিকা যোগ করা হয়েছে."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖర్చు సమర్పించబడింది. మీ ఇంటి ఖర్చుల జాబితాకు కూడా జోడించబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च सादर केला. तसेच तुमच्या घर खर्चाच्या यादीत जोडले."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செலவு சமர்ப்பிக்கப்பட்டது. உங்கள் வீட்டு செலவு பட்டியலிலும் சேர்க்கப்பட்டது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખર્ચ સબમિટ. તમારા ઘરના ખર્ચની સૂચિમાં પણ ઉમેરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೆಚ್ಚ ಸಲ್ಲಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಮನೆ ವೆಚ್ಚದ ಪಟ್ಟಿಗೆ ಸಹ ಸೇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെലവ് സമർപ്പിച്ചു. നിങ്ങളുടെ വീട്ടുചെലവ് ലിസ്റ്റിലേക്കും ചേർത്തു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖਰਚਾ ਪੇਸ਼ ਕੀਤਾ। ਤੁਹਾਡੇ ਘਰ ਦੇ ਖਰਚੇ ਦੀ ਸੂਚੀ ਵਿੱਚ ਵੀ ਸ਼ਾਮਲ ਕੀਤਾ ਗਿਆ ਹੈ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépense soumise. Également ajouté à votre liste de dépenses résidentielles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto presentado. También agregado a la lista de gastos de su hogar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال النفقات. تمت إضافتها أيضًا إلى قائمة نفقات منزلك."
          }
        }
      }
    },
