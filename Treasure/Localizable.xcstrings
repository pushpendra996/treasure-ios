    "hint_login_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not login, Please proceed for login to perform this action"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप लॉगिन नहीं हैं, कृपया इस क्रिया को करने के लिए लॉगिन के लिए आगे बढ़ें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি লগইন করছেন না, অনুগ্রহ করে এই ক্রিয়াটি সম্পাদন করতে লগইন করার জন্য এগিয়ে যান"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు లాగిన్ కాలేదు, దయచేసి ఈ చర్యను చేయడానికి లాగిన్ కోసం కొనసాగండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही लॉगिन नाही आहात, कृपया ही क्रिया करण्यासाठी लॉग इन करण्यासाठी पुढे जा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழையவில்லை, இந்தச் செயலைச் செய்ய உள்நுழைய தொடரவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે લૉગિન નથી, કૃપા કરીને આ ક્રિયા કરવા માટે લૉગિન માટે આગળ વધો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಲಾಗಿನ್ ಆಗಿಲ್ಲ, ಈ ಕ್ರಿಯೆಯನ್ನು ನಿರ್ವಹಿಸಲು ದಯವಿಟ್ಟು ಲಾಗಿನ್ ಮಾಡಲು ಮುಂದುವರಿಯಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ലോഗിൻ ചെയ്തിട്ടില്ല, ഈ പ്രവർത്തനം നടത്താൻ ലോഗിൻ ചെയ്യുന്നതിനായി ദയവായി തുടരുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਲੌਗਇਨ ਨਹੀਂ ਹੋ, ਕਿਰਪਾ ਕਰਕੇ ਇਸ ਕਾਰਵਾਈ ਨੂੰ ਕਰਨ ਲਈ ਲੌਗਇਨ ਲਈ ਅੱਗੇ ਵਧੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'êtes pas connecté, veuillez procéder à la connexion pour effectuer cette action"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha iniciado sesión. Continúe con el inicio de sesión para realizar esta acción."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تقم بتسجيل الدخول، يرجى متابعة تسجيل الدخول لتنفيذ هذا الإجراء"
          }
        }
      }
    },
    "hint_login_rules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you agree to our\nTerms and Conditions  Privacy Policy"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखकर आप हमारे\nनियम और शर्तों गोपनीयता नीति से सहमत हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যাওয়ার মাধ্যমে আপনি আমাদের\nনিয়ম ও শর্তাবলী গোপনীয়তা নীতি সম্মত হন"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగించడం ద్వారా మీరు మా\nనిబంధనలు మరియు షరతులు గోప్యతా విధానానికి అంగీకరిస్తున్నారు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू ठेवून तुम्ही आमच्या\nअटी आणि नियमांना गोपनीयता धोरण यांना सहमती दर्शवता"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்வதன் மூலம் எங்கள்\nவிதிமுறைகள் மற்றும் நிபந்தனைகள் தனியுரிமைக் கொள்கையை ஏற்கிறீர்கள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ રાખીને તમે અમારી\nનિયમો અને શરતો ગોપનીયતા નીતિ સાથે સંમત થાઓ છો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದುವರಿಸುವ ಮೂಲಕ ನೀವು ನಮ್ಮ\nನಿಯಮಗಳು ಮತ್ತು ಷರತ್ತುಗಳು ಗೌಪ್ಯತೆ ನೀತಿಗೆ ಸಮ್ಮತಿಸುತ್ತೀರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടരുന്നതിലൂടെ നിങ്ങൾ ഞങ്ങളുടെ\nനിബന്ധനകളും വ്യവസ്ഥകളും സ്വകാര്യതാ നയം അംഗീകരിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਰੀ ਰੱਖ ਕੇ ਤੁਸੀਂ ਸਾਡੇ\nਨਿਯਮਾਂ ਅਤੇ ਸ਼ਰਤਾਂ ਪਰਦੇਦਾਰੀ ਨੀਤੀ ਨਾਲ ਸਹਿਮਤ ਹੁੰਦੇ ਹੋ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez nos\nConditions générales Politique de confidentialité"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas nuestros\nTérminos y condiciones Política de privacidad"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من خلال المتابعة، فإنك توافق على\nالشروط والأحكام سياسة الخصوصية"
          }
        }
      }
    },
    "hint_login_tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step far from the unlimited entertainment at Treasure"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure पर असीमित मनोरंजन से एक कदम दूर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure-এ সীমাহীন বিনোদন থেকে এক ধাপ দূরে"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasureలో అపరిమిత వినోదం నుండి ఒక అడుగు దూరంలో ఉంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure वरील अमर्याद मनोरंजनापासून एक पाऊल दूर"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure இல் உள்ள வரம்பற்ற பொழுதுபோக்கிலிருந்து ஒரு படி தூரம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure પર અમર્યાદિત મનોરંજનથી એક પગલું દૂર"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure ನಲ್ಲಿ ಅನಿಯಮಿತ ಮನರಂಜನೆಯಿಂದ ಒಂದು ಹೆಜ್ಜೆ ದೂರವಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure എന്നതിലെ പരിധിയില്ലാത്ത വിനോദങ്ങളിൽ നിന്ന് ഒരു പടി അകലെ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Treasure 'ਤੇ ਅਸੀਮਤ ਮਨੋਰੰਜਨ ਤੋਂ ਇੱਕ ਕਦਮ ਦੂਰ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À deux pas du divertissement illimité sur Treasure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A un paso del entretenimiento ilimitado en Treasure"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على بعد خطوة واحدة من الترفيه غير المحدود في Treasure"
          }
        }
      }
    },
    "hint_logout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logout"
          }
        },
        "hi": {
          "stringUnit": {
